# ── Server-only secrets (contact form backend) ───────────────────────────────
# Set these in .env.local for local dev, and in Netlify > Site settings >
# Environment variables for production. NEVER commit real values.
#
# IMPORTANT: this is a SEPARATE application/site from slo-web-design. Even
# though the env var NAMES below intentionally mirror slo-web-design's
# convention (for anyone who knows that repo), the VALUES here must be this
# app's own Supabase project keys and this app's own Resend API key — they are
# not shared secrets copied from slo-web-design's .env.local.

# Supabase (service role key: Supabase dashboard > Settings > API)
# The slof_form_submissions table lives in the same shared Supabase project
# used by other sites on this Netlify team, per the migration in this repo's
# instructions — but the URL/key pair below is still this app's own config,
# not a copy-paste of another app's .env.local.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) — sender must be on a verified domain in production
RESEND_API_KEY=re_your_api_key
INQUIRY_FROM_EMAIL=Southern LoCal Fulfillment <inquiries@slocalfulfillment.com>
OWNER_EMAIL=louwrensventures@gmail.com
