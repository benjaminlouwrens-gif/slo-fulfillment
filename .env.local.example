# ── Server-only secrets (contact form backend) ───────────────────────────────
# Set these in .env.local for local dev, and in Netlify > Site settings >
# Environment variables for production. NEVER commit real values.
#
# This app stores only slof_* records in the shared Supabase project.
# Keep every real value server-side and out of the repository.

# Supabase (service role key: Supabase dashboard > Settings > API)
# The slof_form_submissions and slof_faq_requests tables live in that project.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FAQ chat; reuse the authorized Zhipu key only in server-side environment.
ZHIPU_API_KEY=your-zhipu-api-key

# Resend (https://resend.com) — sender must be on a verified domain in production
RESEND_API_KEY=re_your_api_key
INQUIRY_FROM_EMAIL=Southern LoCal Fulfillment <inquiries@slocalfulfillment.com>
OWNER_EMAIL=louwrensventures@gmail.com
